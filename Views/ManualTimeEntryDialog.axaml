<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TimeTracker.ViewModels"
        xmlns:models="using:TimeTracker.Models"
        x:Class="TimeTracker.Views.ManualTimeEntryDialog"
        x:DataType="vm:ManualTimeEntryViewModel"
        Title="{Binding Title}"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Project"/>
        <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:Project">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Task"/>
        <ComboBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                  HorizontalAlignment="Stretch" PlaceholderText="This project has no tasks">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:ProjectTask">
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Date"/>
        <DatePicker SelectedDate="{Binding Date}"/>

        <Grid ColumnDefinitions="*,8,*">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Start (HH:mm)"/>
                <TextBox Text="{Binding StartTime}" PlaceholderText="09:00"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="End (HH:mm)"/>
                <TextBox Text="{Binding EndTime}" PlaceholderText="10:30"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Remarks"/>
        <TextBox Text="{Binding Description}" PlaceholderText="What did you work on?"/>

        <TextBlock Text="AI Time Saved (hours)"/>
        <TextBox Text="{Binding AiTimeSavedHours}" PlaceholderText="0 or 0.5"/>

        <TextBlock x:Name="ErrorText"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   MinHeight="20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button Content="Cancel" Click="CancelButton_Click" Width="90"/>
            <Button Content="OK"     Click="OkButton_Click"     Width="90" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
