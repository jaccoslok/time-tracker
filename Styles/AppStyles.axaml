<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>

            <!-- ── Theme-aware palette ────────────────────────────────────────────
                 Each key exists in both dictionaries; DynamicResource picks the one
                 matching the current light/dark mode and updates when it changes.

                 Keys like "ButtonBackground" are Fluent theme keys: defining them here
                 overrides the colours of Fluent's built-in controls, because this style
                 file comes after <FluentTheme/> in App.axaml and later resources win.   -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <!-- App palette -->
                    <SolidColorBrush x:Key="WindowBrush"    Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ListBrush"      Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentBrush"    Color="#2F6FEB"/>
                    <SolidColorBrush x:Key="MutedBrush"     Color="#6B7280"/>
                    <SolidColorBrush x:Key="CardBrush"      Color="#F1F3F6"/>
                    <SolidColorBrush x:Key="DividerBrush"   Color="#D9DDE3"/>
                    <SolidColorBrush x:Key="HeaderBrush"    Color="#F6F7F9"/>
                    <SolidColorBrush x:Key="TabPanelBrush"  Color="#F6F7F9"/>
                    <SolidColorBrush x:Key="BelowBrush"     Color="#DC2626"/>
                    <SolidColorBrush x:Key="OnTargetBrush"  Color="#16A34A"/>

                    <!-- Fluent: tabs as pills, the selected one orange like the Xojo app -->
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected"             Color="#F88520"/>
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver"  Color="#F99536"/>
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPressed"      Color="#E07612"/>
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected"           Color="#E6E8EC"/>
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="#DADDE2"/>
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPressed"    Color="#CED2D8"/>
                    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected"             Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver"  Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed"      Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill"               Color="Transparent"/>
                </ResourceDictionary>

                <!-- Colours measured from the Xojo TimeTracker3 app in dark mode -->
                <ResourceDictionary x:Key="Dark">
                    <!-- App palette -->
                    <SolidColorBrush x:Key="WindowBrush"    Color="#20242F"/>
                    <SolidColorBrush x:Key="ListBrush"      Color="#1D1D1D"/>
                    <SolidColorBrush x:Key="AccentBrush"    Color="#5B9BFF"/>
                    <SolidColorBrush x:Key="MutedBrush"     Color="#9A9DA4"/>
                    <SolidColorBrush x:Key="CardBrush"      Color="#2F333D"/>
                    <SolidColorBrush x:Key="DividerBrush"   Color="#3C3C3C"/>
                    <SolidColorBrush x:Key="HeaderBrush"    Color="#2A2E39"/>
                    <SolidColorBrush x:Key="TabPanelBrush"  Color="#272B36"/>
                    <SolidColorBrush x:Key="BelowBrush"     Color="#F87171"/>
                    <SolidColorBrush x:Key="OnTargetBrush"  Color="#4ADE80"/>

                    <!-- Fluent: buttons -->
                    <SolidColorBrush x:Key="ButtonBackground"             Color="#30343F"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#3A3E49"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#444852"/>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled"     Color="#282C37"/>
                    <SolidColorBrush x:Key="ButtonForeground"             Color="#DFE0E2"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed"      Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonForegroundDisabled"     Color="#5D6068"/>
                    <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"     Color="Transparent"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled"    Color="Transparent"/>

                    <!-- Fluent: drop-downs (the timer's project/task pickers) -->
                    <SolidColorBrush x:Key="ComboBoxBackground"             Color="#30343F"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver"  Color="#3A3E49"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed"      Color="#444852"/>
                    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled"     Color="#282C37"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrush"            Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed"     Color="Transparent"/>
                    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled"    Color="Transparent"/>

                    <!-- Fluent: text fields -->
                    <SolidColorBrush x:Key="TextControlBackground"            Color="#2E2E2E"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#333333"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused"     Color="#2E2E2E"/>
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled"    Color="#262626"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush"           Color="#3C3C3C"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4A4A4A"/>

                    <!-- Fluent: list rows. Neutral grey selection instead of the blue accent -->
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush"    Color="#464646"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#4E4E4E"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush"   Color="#555555"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush"          Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush"       Color="#333333"/>

                    <!-- Fluent: tabs as pills, the selected one orange -->
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected"             Color="#F88520"/>
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver"  Color="#F99536"/>
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPressed"      Color="#E07612"/>
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected"           Color="#30343F"/>
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="#3A3E49"/>
                    <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPressed"    Color="#444852"/>
                    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected"             Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver"  Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed"      Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected"           Color="#DFE0E2"/>
                    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPressed"    Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill"               Color="Transparent"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="AppFontSize">13</x:Double>

        </ResourceDictionary>
    </Styles.Resources>

    <!-- ── Base control styles ─────────────────────────────────────────────── -->

    <!-- Applies to MainWindow and every dialog (they all derive from Window) -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Padding"      Value="10,4"/>
        <Setter Property="FontSize"     Value="{StaticResource AppFontSize}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AppFontSize}"/>
    </Style>

    <!-- Small "+", "Edit…", "−" buttons next to a list heading -->
    <Style Selector="Button.small">
        <Setter Property="Padding"   Value="8,1"/>
        <Setter Property="MinWidth"  Value="28"/>
    </Style>

    <!-- Upper-case headings: PERIOD, PROJECTS, TASKS, SUMMARY -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize"          Value="11"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource MutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>

    <!-- Summary detail lines: below the minimum = red, at or above the target = green.
         Defined after .muted so these win when both classes are set. -->
    <Style Selector="TextBlock.below">
        <Setter Property="Foreground" Value="{DynamicResource BelowBrush}"/>
    </Style>
    <Style Selector="TextBlock.ontarget">
        <Setter Property="Foreground" Value="{DynamicResource OnTargetBrush}"/>
    </Style>

    <!-- The running time in the timer bar. Menlo is macOS, Consolas Windows; the first one found is used. -->
    <Style Selector="TextBlock.clock">
        <Setter Property="FontFamily" Value="Menlo, Consolas, Courier New"/>
        <Setter Property="FontSize"   Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background"   Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding"      Value="12,8"/>
        <Setter Property="Margin"       Value="0,0,0,8"/>
    </Style>

    <!-- ── Tables (ListBox with a column header row) ───────────────────────── -->

    <Style Selector="Border.table">
        <Setter Property="Background"      Value="{DynamicResource ListBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Same radius as Border.card; ClipToBounds clips the header and the
             selected-row highlight to the rounded corners -->
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="ClipToBounds"    Value="True"/>
    </Style>

    <Style Selector="Border.tableheader">
        <Setter Property="Background"      Value="{DynamicResource HeaderBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <!-- Rounded top corners, matching the table's outer border -->
        <Setter Property="CornerRadius"    Value="7,7,0,0"/>
        <Setter Property="Padding"         Value="8,3"/>
    </Style>

    <Style Selector="Border.tableheader TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="ListBox.table">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Compact rows; Fluent's default ListBoxItem is much taller -->
    <Style Selector="ListBox.table ListBoxItem">
        <Setter Property="Padding"  Value="8,2"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <!-- Closed projects/tasks: the "closed" class is toggled by a binding in the list templates -->
    <Style Selector="TextBlock.closed">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- The "(All projects)" / "(All tasks)" rows -->
    <Style Selector="TextBlock.allrow">
        <Setter Property="FontStyle"  Value="Italic"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>

    <!-- ── Tab group (Activities / Charts) ─────────────────────────────────────
         Like the Xojo tab panel: a rounded panel with the tabs as centred pills
         sitting on its top edge. "/template/" reaches inside the control's template. -->

    <Style Selector="Border.tabpanel">
        <Setter Property="Background"      Value="{DynamicResource TabPanelBrush}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="8"/>
    </Style>

    <Style Selector="TabControl.pills /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TabControl.pills TabItem">
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="MinHeight"    Value="26"/>
        <Setter Property="Height"       Value="26"/>
        <Setter Property="Padding"      Value="14,0"/>
        <Setter Property="Margin"       Value="2,0"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="TabControl.pills TabItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="TabControl.pills TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <!-- A ProgressBar from 0 to Maximum makes a simple horizontal bar -->
    <Style Selector="ProgressBar.bar">
        <Setter Property="Foreground"   Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Height"       Value="16"/>
        <Setter Property="MinHeight"    Value="16"/>
        <Setter Property="MinWidth"     Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</Styles>
